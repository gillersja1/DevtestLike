<?xml version="1.0" encoding="utf-8"?>
<!-- The policy service's response contract. Every response the tests receive is validated against it. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:p="http://devtestlike.example/policy"
           targetNamespace="http://devtestlike.example/policy"
           elementFormDefault="qualified">

  <xs:simpleType name="Money">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Uuid">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:element name="GetQuoteResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="quoteId" type="p:Uuid"/>
        <xs:element name="status">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="offered"/>
              <xs:enumeration value="declined"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="riskScore">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="0"/>
              <xs:maxInclusive value="100"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="premium" type="p:Money"/>
        <xs:element name="expiresAt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Policy">
    <xs:sequence>
      <xs:element name="policyNumber">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="POL-[0-9]{6,}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="quoteId" type="p:Uuid"/>
      <xs:element name="holderName" type="xs:string"/>
      <xs:element name="premium" type="p:Money"/>
      <xs:element name="status">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="active"/>
            <xs:enumeration value="cancelled"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="issuedAt" type="xs:dateTime"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="IssuePolicyResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="policy" type="p:Policy"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GetPolicyResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="policy" type="p:Policy"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="code" type="xs:string"/>
</xs:schema>
