<?xml version="1.0" encoding="utf-8"?>
<!-- The contract for messages the policy service publishes on the policy.issued queue. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:e="http://devtestlike.example/events"
           targetNamespace="http://devtestlike.example/events"
           elementFormDefault="qualified">

  <xs:element name="PolicyIssued">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="policyNumber">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="POL-[0-9]{6,}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="quoteId">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="holderName" type="xs:string"/>
        <xs:element name="premium">
          <xs:simpleType>
            <xs:restriction base="xs:decimal">
              <xs:fractionDigits value="2"/>
              <xs:minExclusive value="0"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="issuedAt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
